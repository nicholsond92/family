# FastDirect Credentials
FASTDIRECT_SCHOOL_CODE=your_school_code
FASTDIRECT_USERNAME=your_family_id
FASTDIRECT_PASSWORD=your_password

# Microsoft 365 App Registration (Azure AD)
# Register at: https://portal.azure.com/#blade/Microsoft_Intl/AppRegistrationBlade
# Required API permissions: Calendars.ReadWrite, Mail.Read
MS_CLIENT_ID=your_client_id
MS_TENANT_ID=your_tenant_id
# Leave empty to use device code flow (recommended for personal use)
MS_CLIENT_SECRET=

# Optional: specific calendar name (leave empty for default calendar)
MS_CALENDAR_NAME=

# How far back to look for emails (in days)
EMAIL_LOOKBACK_DAYS=7
